# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...

SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SCREEN_COACH
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=

# Seconds between screenshots
CAPTURE_INTERVAL_SEC=15
# How many of the most recent screenshots Claude sees per question
RECENT_IMAGE_COUNT=3
# Max screenshots kept in the database (oldest deleted first)
MAX_SCREENSHOTS=500
